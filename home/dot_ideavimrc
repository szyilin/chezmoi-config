let mapleader=" " " 设置 leader 映射键
"  ================================ 插件 ================================
Plug 'preservim/nerdtree'
Plug 'tpope/vim-surround' " ys, cs, ds, S, 字体环绕
Plug 'vim-commentary' " 使用 gcc 注释单行 gc 注释选中的多行注释
Plug 'argtextobj.vim' " Text Object 模式添加 a 模式表示选中一整个参数
Plug 'michaeljsmith/vim-indent-object' " Text Object 模式添加 i 模式表示选中Python中的缩进块
set textobj-indent
Plug 'machakann/vim-highlightedyank' " 当复制后被复制内容会有短暂延迟光亮
Plug 'vim-scripts/Improved-paragraph-motion' " 使用 { } 可以匹配带有空格的空行
set which-key " 按键提示插件

let g:argtextobj_pairs="(:),{:},<:>"
set clipboard+=unnamed " 使用系统剪贴板

" =============================== 插件设置 ===============================
" nerdtree
" Which-key
" 使用按键提示应该禁用这个选项
set notimeout
" 按键提示延迟
set timeoutlen=5000
" 让 Which-key 同样提示默认 vim 提示
" let g:WhichKey_ShowVimActions = "true"
" 提示排序方式
let g:WhichKey_SortOrder = "by_key_prefix_last"
" vim-highlightedyank 设置
let g:highlightedyank_highlight_duration = "300" " 延迟关闭 ms
" let g:highlightedyank_highlight_color = "rgba(69, 130, 246, 0.22)"
" let g:highlightedyank_highlight_foreground_color = "rgba(0, 0, 0, 255)"
" 打开关闭 nerdtree
nnoremap <leader>o :NERDTreeToggle<CR>
" 定位当前文件位置
nnoremap <leader>e :NERDTreeFind<CR>
" 在目录中使用 space o 关闭目录
" let g:NERDTreeMapQuit=" o"
let g:NERDTreeMapJumpNextSibling="<C-j>"
let g:NERDTreeMapJumpPrevSibling="<C-k>"

" vim-flash（需在 IDE Plugins 市场手动安装插件 vim-flash，与 Neovim flash.nvim 键位对齐）
nmap s <Action>(flash.search)
xmap s <Action>(flash.search)
nmap S <Action>(flash.treesitter)
xmap S <Action>(flash.treesitter)
nmap f <Action>(flash.find)
xmap f <Action>(flash.find)
nmap F <Action>(flash.find_backward)
xmap F <Action>(flash.find_backward)
nmap t <Action>(flash.till)
xmap t <Action>(flash.till)
nmap T <Action>(flash.till_backward)
xmap T <Action>(flash.till_backward)
nmap ; <Action>(flash.repeat)
xmap ; <Action>(flash.repeat)
nmap , <Action>(flash.repeat_backward)
xmap , <Action>(flash.repeat_backward)
omap r <Action>(flash.remote)

"  ============================== keyMap 键盘映射 ========================
" $ 在 v 模式下不会选中回车符号"
vnoremap $ $<Left>
" 让 & :s 重复命令可以保留标识位
nnoremap & :&&<CR>
vnoremap & :&&<CR>
" 选中模式下缩进一次不会取消选中
vnoremap < <gv
vnoremap > >gv
" * 和 # 不自动跳到下一个位置
nnoremap # viwy:let @/='<C-r>"'<CR>:set hlsearch<CR>
nnoremap * viwy:let @/='<C-r>"'<CR>:set hlsearch<CR>
" 清空高亮
nnoremap <C-l> :noh<CR>
" 输入时候更方便
inoremap <C-e> <END>
inoremap <C-a> <Esc>^i
inoremap <C-b> <Left>
inoremap <C-n> <Down>
inoremap <C-p> <Up>
inoremap <C-f> <Right>
" 严格让 CTRL + c 匹配 esc
inoremap <C-c> <Esc>
nnoremap <C-c> <Esc>
vnoremap <C-c> <Esc>
" 代码定义跳转
nnoremap gd :<C-u>action GotoDeclaration<CR>
nnoremap gi :<C-u>action GotoImplementation<CR>
" ideavim 插件相关
nnoremap <leader>Cr :action IdeaVim.ReloadVimRc.reload<CR>
nnoremap <leader>Cl :actionlist<CR>

" ================================ 屏幕移动相关配置 ================================
nnoremap <leader>bd :bd<CR>
nnoremap <C-n> gt
nnoremap <C-p> gT
nnoremap <C-o> :action Back<CR>
nnoremap <C-i> :action Forward<CR>
" 打开终端窗口
:map <C-/> <Action>(ActivateTerminalToolWindow)

" ================================= 基础配置 ===================================
" 显示行号
set nu
" 相对定位行号
set relativenumber
" 支持搜索高亮
set hlsearch
" 光标距离最顶行数目
set scrolloff=5
" 边输入边搜索
set incsearch
" 搜索大小写不敏感，除非包含大写
set ignorecase
set smartcase
" 搜索高亮 :noh - 取消高亮
set hlsearch
" 返回正常模式切换输入法
set keep-english-in-normal

"  =================== 来自 ideaVim 的默认设置说明文档等 ======================
" Don't use Ex mode, use Q for formatting.
map Q gq
" 输入 J 自动拼接可拼接的两部分内容
set ideajoin
"" -- Map IDE actions to IdeaVim -- https://jb.gg/abva4t
"  ========================== 编写代码相关映射 ===============================
" 映射 == 到 代码格式化功能
nnoremap == :action ReformatCode<CR>
" 优化导包
nnoremap =i :action OptimizeImports<CR>
" 跳转错误
nnoremap ]e :action GotoNextError<CR>
nnoremap [e :action GotoPreviousError<CR>
" 重命名 文件
nnoremap <Leader>n :action RenameFile<CR>
vnoremap <Leader>n :action RenameFile<CR>
" 重命名 变量、类名
nnoremap <Leader>n :action RenameElement<CR>
vnoremap <Leader>n :action RenameElement<CR>
" 抽取方法
nnoremap <Leader>m :action ExtractMethod<CR>
vnoremap <Leader>m :action ExtractMethod<CR>
" 抽取变量
nnoremap <Leader>v :action IntroduceVariable<CR>
vnoremap <Leader>v :action IntroduceVariable<CR>
" ========================= 运行代码 Run ====================================
" 运行当前光标下可运行的内容
map <leader>rr <Action>(RunClass)
" 打开查找所有可运行的查找窗口
map <leader>rf <Action>(RunAnything)
" Stop 结束表头运行的程序，结束当前操作台正在运行中的程序
map <leader>rs <Action>(Stop)
" StopBackgroundProcesses 结束当前光标下的运行程序 "
" ============================= Git 相关 ====================================
" 展示修改时间和作者
nnoremap <Leader>ga :action Annotate<CR>
" 下一个变化
map <leader>gj <Action>(NextDiff)
" 上一个变化
map <leader>gk <Action>(PreviousDiff)
" Branches Optional 分支选项
map <leader>gb <Action>(Git.Branches)
" pull
nnoremap <leader>gl :action Vcs.UpdateProject<CR>
" commit
nnoremap <leader>gc :action CheckinProject<CR>
" push
nnoremap <leader>gp :action Vcs.Push<CR>
" ============================ 文件查找相关 ===============================
" 按照路径查找
nnoremap <Leader>fu :action GotoUrlAction<CR>
" 按照文本内容查找
nnoremap <Leader>fa :action FindInPath<CR>
nnoremap <Leader>/ :action FindInPath<CR>
" 按照文件名称查找
nnoremap <Leader>ff :action GotoFile<CR>
nnoremap <leader><space> :action GotoFile<CR>
" ============================ 代码调试 Debug ===============================
" 切换到当前行的断点
"map \b <Action>(ToggleLineBreakpoint)
" Find more examples here: https://jb.gg/share-ideavimrc
" 在这里找到更多例子
" :actionlist 这个命令可以显示 idea 允许那些 action 命令被映射

