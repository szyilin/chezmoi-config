[
  // 将 ctrl 开头的键位发送到 neovim 插件管理
  {
    "command": "vscode-neovim.send",
    "key": "ctrl+n",
    "when": "editorTextFocus && neovim.mode != insert",
    "args": "<C-n>"
  },
  {
    "command": "vscode-neovim.send",
    "key": "ctrl+p",
    "when": "editorTextFocus && neovim.mode != insert",
    "args": "<C-p>"
  },
  // 适配资源管理器 vim 使用习惯
  {
    "key": "space o",
    "command": "workbench.action.closeSidebar",
    "when": "listFocus && !inputFocus && !treestickyScrollFocused"
  },
  {
    "key": "space e",
    "command": "workbench.action.closeSidebar",
    "when": "listFocus && !inputFocus && !treestickyScrollFocused"
  }
]
