# ============================================== 环境变量配置 start ===================================================
export LOCAL_HOME=~/.local
export PATH=$PATH:"$LOCAL_HOME/bin"

# brew home
export BREW_HOME="{{ if eq .chezmoi.os "darwin" }}/opt/homebrew{{ else if eq .chezmoi.os "linux" }}/home/linuxbrew/.linuxbrew{{ end }}"
export PATH=$PATH:"$BREW_HOME/bin"

# brew 安装后按照提示进行的配置
export NVM_DIR="$HOME/.nvm"
[ -s "$BREW_HOME/opt/nvm/nvm.sh" ] && \. "$BREW_HOME/opt/nvm/nvm.sh"  # This loads nvm
[ -s "$BREW_HOME/opt/nvm/etc/bash_completion.d/nvm" ] && \. "$BREW_HOME/opt/nvm/etc/bash_completion.d/nvm"  # This loads nvm bash_completion

# rust 开发环境
[ -s "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"

# 自定义 Java 开发环境
export JAVA_HOME=/usr/local/java/jdk8/Contents/Home
export PATH=$PATH:"$JAVA_HOME/bin"

# idea 自带 maven
export MAVEN_HOME=/Applications/IntelliJ\ IDEA.app/Contents/plugins/maven/lib/maven3
export PATH=$PATH:"$MAVEN_HOME/bin"

# brew 下载的 msyql 9.0 客户端
export MYSQL_HOME=/opt/homebrew/Cellar/mysql-client@8.0/8.0.41
export PATH=$PATH:"$MYSQL_HOME/bin"

# pyenv 环境变量
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init - zsh)"

# editor 终端默认编辑器
if command -v nvim >/dev/null 2>&1; then
    export EDITOR=nvim
else
    export EDITOR=vim
fi

# 自定义脚本，导入环境变量 (XDG 标准)
if [ -s "$HOME/.local/bin" ]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

# 确保导出
export PATH
# ============================================== 环境变量配置 end   ===================================================


# ============================================== Clash 代理配置 (Linux) start ===================================================
{{- if eq .chezmoi.os "linux" }}
# 加载 clash 代理控制函数 (仅 Linux 系统)
if [[ -f "/opt/clash/script/common.sh" ]] && [[ -f "/opt/clash/script/clashctl.sh" ]]; then
    source "/opt/clash/script/common.sh" 2>/dev/null
    source "/opt/clash/script/clashctl.sh" 2>/dev/null
fi
{{- end }}
# ============================================== Clash 代理配置 (Linux) end   ===================================================


# ============================================== 别名配置 start ===================================================
alias ll='ls -lF'
# 如果存在 nvim 那么指向，否则默认
if command -v nvim &>/dev/null; then
  alias vim='nvim'
  alias vi='vi'
else
  alias vim='vim'
  alias vi='vi'
fi
# 代理打开关闭
proxy_on () {
    local host="127.0.0.1"

    # Clash Verge 端口
    local http_port=7897
    local socks5_port=7897

    # 端口打开判断
    if nc -z $host $http_port >/dev/null 2>&1; then
        export https_proxy=http://$host:$http_port
        export http_proxy=http://$host:$http_port
        export all_proxy=socks5://$host:$socks5_port
        echo -e "CLI proxy opened"
        return 0
    fi

    # 两个都没开
    echo -e "CLI proxy open fail"
    return 1
}
proxy_off () {
    unset http_proxy https_proxy all_proxy
    echo -e "CLI proxy closed"
}
proxy_on
{{ if eq .chezmoi.os "darwin" }}
# rm 命令替换
alias rm-real='/bin/rm'
rm() {
  files=()

  # 只收集不是以 - 开头的参数
  for arg in "$@"; do
    if [[ "$arg" != -* ]]; then
      files+=("$arg")
    fi
  done

  if [[ ${#files[@]} -eq 0 ]]; then
    echo "⚠️ 未检测到有效的文件路径（所有参数均为选项）"
    return 1
  fi

  # 调用 trash 删除真正的文件参数
  command trash "${files[@]}"
}
{{ end }}
# tmux 指定配置文件地址
if command -v tmux &>/dev/null; then
  alias tmux="tmux -f ~/.config/tmux/.tmux.conf"
fi
# 配置 brew 自动备份命令
brew-bundle() {
  local brew_file_name="{{ if eq .chezmoi.os "darwin" }}brewfile-mac{{ else if eq .chezmoi.os "linux" }}brewfile-linux{{ else }}brewfile-other{{ end }}"
  brew bundle dump --describe --file="$(chezmoi source-path)/resources/${brew_file_name}" --force
}
# ============================================== 别名配置 end   ===================================================

